# Build stage - includes all dependencies needed for building
FROM node:lts-alpine AS builder

WORKDIR /app

# Copy package files first for better caching
COPY ./package.json ./package-lock.json* /app/
COPY ./site/package.json ./site/package-lock.json* /app/site/

# Install all dependencies (including devDependencies for building)
RUN npm ci --no-audit --no-fund

# Copy source code
COPY ./site /app/site
COPY ./db /app/db

WORKDIR /app/site

RUN npm run build

# Production stage - minimal image with only runtime dependencies
FROM node:lts-alpine AS production

EXPOSE 3000
WORKDIR /app

# Copy package files and install only production dependencies
COPY ./package.json ./package-lock.json* /app/
COPY ./site/package.json ./site/package-lock.json* /app/site/
COPY ./db /app/db

RUN npm ci --workspace=site --only=production --no-audit --no-fund && \
	npm cache clean --force

# Copy built application from builder stage
COPY --from=builder /app/site/build /app/site/build

WORKDIR /app/site

CMD ["npm", "run", "start"]